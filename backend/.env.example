# Examples only. Replace with dedicated development configuration.
ENVIRONMENT=development
MONGODB_URI=mongodb://127.0.0.1:27017
DB_NAME=versa_development
ORG_DB_NAME=versa_organizations_development
STAGING_DB_NAME=versa_staging
STAGING_ORG_DB_NAME=versa_organizations_staging
REQUIRE_MONGO=false
JWT_SECRET=replace-with-independent-random-jwt-secret
API_KEY_SECRET=replace-with-independent-random-api-key-hashing-secret
DEFAULT_SIGNUP_CREDITS=0
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ROOT_PATH=
GOOGLE_API_KEY=
COMPLIANCE_VISION_MODEL=gemini-2.5-flash
# Required at app import; blank values deliberately prevent accidental startup.
DO_ACCESS_KEY_ID=
DO_SECRET_KEY=
ENDPOINT=
SPACENAME=
# Legacy aliases ACCESS_KEY_ID and SECRET_KEY are supported but discouraged.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_T_STARTER=
STRIPE_PRICE_T_GROWTH=
STRIPE_PRICE_T_SCALE=
STRIPE_PRICE_M_STARTER=
STRIPE_PRICE_M_GROWTH=
STRIPE_PRICE_M_SCALE=
# Add-on fallback names use STRIPE_PRICE_<PLAN_CODE>.
STRIPE_PRICE_TEST_DAILY=
SMTP_SERVER=
SMTP_PORT=587
SENDER_EMAIL=
SENDER_PASSWORD=
